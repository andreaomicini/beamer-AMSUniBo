%% The palette of the AMSUniBo theme for the APICe wiki. Each name mirrors the
%% LESS variable beside it. Provenance and roles: see README.md.

\mode<presentation>

%% base colours
\definecolor{amsred}{HTML}{BB2E29}         % @ams-red
\definecolor{amsreddark}{HTML}{8E2320}     % @ams-red-dark
\definecolor{amsblack}{HTML}{000000}       % @ams-black
\definecolor{amstext}{HTML}{040404}        % @ams-text
\definecolor{amsgreen}{HTML}{56A49A}       % @ams-green
\definecolor{amsgreenlight}{HTML}{74BDAD}  % @ams-green-light
\definecolor{amsgreendark}{HTML}{366861}   % @ams-green-dark
\definecolor{amsgreentint}{HTML}{DDEDEB}   % @ams-green-tint
\definecolor{amsgreentint2}{HTML}{CCE4E1}  % @ams-green-tint2
\definecolor{amsgrey}{HTML}{464A51}        % @ams-grey
\definecolor{amsgreymid}{HTML}{535353}     % @ams-grey-mid
\definecolor{amsgreyline}{HTML}{C7C9CB}    % @ams-grey-line
\definecolor{amsgreybg}{HTML}{F0F1F1}      % @ams-grey-bg
\definecolor{amswhite}{HTML}{FFFFFF}
\definecolor{basecolour}{HTML}{BB2E29}     % rosso istituzionale

%% block fills, as the web theme's LESS computes them
\definecolor{amsredfill}{HTML}{F6D9D8}     % @state-danger-bg
\definecolor{amsredborder}{HTML}{EBA8A6}   % @state-danger-border
\definecolor{amsgreenfill}{HTML}{E1EFED}   % @state-success-bg
\definecolor{amsgreenborder}{HTML}{B2D7D2} % @state-success-border

%% red is the identity colour, green the structural one
\setbeamercolor{structure}{fg=amsgreendark}
\setbeamercolor{section in toc}{fg=amsgreendark,bg=amswhite}
\setbeamercolor{alerted text}{fg=amsred}

%% palettes, light to loud; quaternary carries the navbar red
\setbeamercolor*{palette primary}{fg=amsgreymid,bg=amsgreentint}
\setbeamercolor*{palette secondary}{fg=amstext,bg=amsgreentint2}
\setbeamercolor*{palette tertiary}{fg=amswhite,bg=amsgreendark}
\setbeamercolor*{palette quaternary}{fg=amswhite,bg=amsred}

\setbeamercolor*{sidebar}{fg=amsgreendark,bg=amsgreentint}
\setbeamercolor*{palette sidebar primary}{fg=amstext}
\setbeamercolor*{palette sidebar secondary}{fg=amsgreymid}
\setbeamercolor*{palette sidebar tertiary}{fg=amsgreendark}
\setbeamercolor*{palette sidebar quaternary}{fg=amswhite}

%% title and frame title
\setbeamercolor{titlelike}{parent=palette primary,fg=amsblack}
\setbeamercolor{frametitle}{fg=amsblack,bg=amsgreentint}
\setbeamercolor{frametitle right}{bg=amsgreentint2}

%% rules
\setbeamercolor*{separation line}{fg=amsgreen}
\setbeamercolor*{fine separation line}{fg=amsgreyline}

\mode
<all>
