%% The AMSBolognaFC Beamer style in the colours and the faces of the AMSUniBo
%% theme for the APICe wiki. Palette: beamercolorthemeamsunibo.sty. Everything
%% else, reasoning included: README.md.
%% name
\newcommand{\stylename}{AMSUniBo Beamer style}
%% version -- Major.Minor[.Patch]; the release time-stamp is appended by the CI
\newcommand{\stylemajor}{1}
\newcommand{\styleminor}{6}
%% \stylepatch is optional: comment the next line out to release as Major.Minor
\newcommand{\stylepatch}{2}
\ifdefined\stylepatch
  \newcommand{\styleversion}{\stylemajor.\styleminor.\stylepatch}
\else
  \newcommand{\styleversion}{\stylemajor.\styleminor}
\fi
\typeout{}
\typeout{\stylename-\styleversion}
%% options
\newif\if@doApice
\@doApicefalse
\DeclareOption{apice}{\@doApicetrue}
%% which seal watermarks the slides -- none unless asked for: bologna (the Ateneo)
%% or cesena (the Campus). The seals belong to the Alma Mater, so a deck claims
%% one explicitly; whoever is outside the Alma Mater just leaves the option out
\newif\if@doSeal
\@doSealfalse
\newif\if@doCesena
\@doCesenafalse
\DeclareOption{bologna}{\@doSealtrue\@doCesenafalse}
\DeclareOption{cesena}{\@doSealtrue\@doCesenatrue}
\ProcessOptions
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\mode<presentation>
%
%% the APICe marker; expands to nothing without the apice option. It carries its
%% own trailing gap, outside the link so the hotspot stops at the word: the .bst
%% appends two spaces after \apicepar, but BibTeX wraps the .bbl line there and
%% the newline collapses them into one \tiny space, which the DOI runs into
\if@doApice
\newcommand{\apicepar}[1]{{\textcolor{amsgreendark}{\tiny\href{https://apice.unibo.it/xwiki/bin/view/Publication/#1}{\textsf{APICe}}\mbox{~~~}}}}
\else
\newcommand{\apicepar}[1]{}
\fi
%
\setbeamertemplate{navigation symbols}{}
%
\useoutertheme{infolines}
\useinnertheme[shadow=true]{rounded}
%%% TO UNCOMMENT FOR LOCAL DIR
\usecolortheme{amsunibo}
%% background -- plain by default; with bologna or cesena, a seal in grey cropped
%% at the lower-right corner: the Ateneo with the former, the Campus di Cesena
%% with the latter. Cesena's ring is solid where the Ateneo's is an outline, so
%% it is set lighter to weigh the same
\setbeamercolor{background canvas}{bg=amswhite}
\if@doSeal
  \if@doCesena
    \pgfdeclareimage[height=.97\paperheight]{bg}{almacesena-background}
  \else
    \pgfdeclareimage[height=.97\paperheight]{bg}{almabologna-background}
  \fi
  \setbeamertemplate{background}{\pgfuseimage{bg}}
\fi
%% text
\setbeamercolor{normal text}{fg=amstext}
\setbeamercolor{alerted text}{fg=amsred}
\setbeamercolor{quote}{fg=amsgreymid}
%% bullets
\setbeamercolor*{item}{fg=amsred}
%% front page
\setbeamercolor{title}{fg=amsblack}
\setbeamercolor{subtitle}{fg=amsgreymid}
\setbeamercolor{author}{fg=amsred}
\setbeamercolor{institute}{fg=amsgrey}
\setbeamercolor{date}{fg=amsgreymid}
%% head and foot lines -- the wiki's navbar over its breadcrumb band
\setbeamercolor{section in head/foot}{fg=amswhite,bg=amsred}
\setbeamercolor{subsection in head/foot}{fg=amstext,bg=amsgreentint2}
\setbeamercolor{author in head/foot}{fg=amswhite,bg=amsgreendark}
\setbeamercolor{title in head/foot}{fg=amstext,bg=amsgreentint2}
\setbeamercolor{date in head/foot}{fg=amsgreymid,bg=amsgreentint}
%% block headers -- block and alerted dark, example light
\setbeamercolor{block title}{use=structure,fg=amswhite,bg=amsgreendark}
\setbeamercolor{block title alerted}{use=alerted text,fg=amswhite,bg=amsred}
\setbeamercolor{block title example}{use=example text,fg=amstext,bg=amsgreenborder}
%% block bodies
\setbeamercolor{block body}{parent=normal text,use=block title,bg=amsgreentint}
\setbeamercolor{block body alerted}{parent=normal text,use=block title alerted,bg=amsredfill}
\setbeamercolor{block body example}{parent=normal text,use=block title example,bg=amsgreenfill}
%% table of contents
\setbeamercolor{section in toc}{fg=amsgreendark}
\setbeamercolor{subsection in toc}{fg=amsgreymid}
%% footnote
\setbeamercolor{footnote mark}{fg=amsred}
\setbeamercolor{footnote}{fg=amsgreymid}
%% biblio
\setbeamertemplate{bibliography item}{\insertbiblabel}
%% the label is a pointer, not a bullet: without this it inherits item's red and
%% collides with the title, which is red on purpose
\setbeamercolor{bibliography item}{fg=amsgreymid}
\setbeamercolor{bibliography entry author}{fg=amstext}
\setbeamercolor{bibliography entry title}{fg=amsred}
\setbeamercolor{bibliography entry location}{fg=amsgreymid}
\setbeamercolor{bibliography entry note}{fg=amsgreendark}
%% abstract
\setbeamercolor*{abstract title}{fg=amsgreendark}
\setbeamerfont*{abstract title}{family=\sffamily}
\setbeamercolor*{abstract}{fg=amsgreymid}
\setbeamerfont*{abstract}{family=\rmfamily,size=\small}
%% paired commands -- the weights are load-bearing, see README.md
%% citation: both light, for the dark surfaces a marker sits on
%% #1 colour, #2 optional note (-NoValue- when absent), #3 keys.  \cite[]{...}
%% is not \cite{...} -- it typesets an empty note -- so the test is on the
%% marker, not on emptiness.  The marker survives being passed down here.
\newcommand{\ams@cite}[3]{%
  \textcolor{#1}{\textsuperscript{\tiny\IfNoValueTF{#2}{\cite{#3}}{\cite[#2]{#3}}}}%
}
\NewDocumentCommand{\ccite}{o m}{\ams@cite{amsgreyline}{#1}{#2}}
\NewDocumentCommand{\cccite}{o m}{\ams@cite{amsgreybg}{#1}{#2}}
%% the address of a URL or a DOI is stringed before it is used, so that a special
%% character in it needs no escaping: \_ and a bare _ alike give one underscore.
%% #1 receives #2 as a string with every backslash dropped -- see README.md
\newcommand{\ams@link@arg}{}
\ExplSyntaxOn
\cs_new_protected:Npn \ams_link_string:Nn #1#2
  {
    \tl_set:Nx #1 { \tl_to_str:n {#2} }
    \exp_args:NNo \tl_remove_all:Nn #1 \c_backslash_str
  }
\cs_new_eq:NN \ams@link@string \ams_link_string:Nn
\ExplSyntaxOff
%% URL: plain dark for light surfaces, doubled light for dark ones
\newcommand{\uurl}[1]{{\ams@link@string\ams@link@arg{#1}%
  \textcolor{amsred}{\scriptsize\expandafter\url\expandafter{\ams@link@arg}}}}
\newcommand{\uuurl}[1]{{\ams@link@string\ams@link@arg{#1}%
  \textcolor{amsgreyline}{\tiny\expandafter\url\expandafter{\ams@link@arg}}}}
%% DOI: likewise. https://doi.org is the current resolver; dx.doi.org is a
%% deprecated alias, and the .bst reaches these through \dddoi, so this is the
%% only place the resolver is named
\newcommand{\ddoi}[1]{{\ams@link@string\ams@link@arg{#1}%
  \textcolor{amsred}{\scriptsize\href{https://doi.org/\ams@link@arg}{DOI:\ams@link@arg}}}}
\newcommand{\dddoi}[1]{{\ams@link@string\ams@link@arg{#1}%
  \textcolor{amsgreyline}{\tiny\href{https://doi.org/\ams@link@arg}{DOI:\ams@link@arg}}}}
%% emph
\renewcommand{\emph}[1]{\textcolor{amsgreendark}{\textit{#1}}}
%% alert -- light, for dark surfaces
%\renewcommand{\alert}[1]{\textcolor{amsred}{#1}}
\newcommand{\aalert}[1]{\textcolor{amsgreyline}{\it#1}}
%% speaker -- both bold: the point is to stand out, and colour alone could not do it.
%% \speaker keeps amsred for the title page; \sspeaker inherits its surface's colour,
%% so it works white-on-green in the footline and dark on a light surface alike
\newcommand{\speaker}[1]{\textcolor{amsred}{\textbf{#1}}}
\newcommand{\sspeaker}[1]{\textbf{#1}}
%
\usepackage[T1]{fontenc}
%% typography -- the web theme's own faces, all Type 1 under pdfLaTeX; README.md
%% text: Merriweather Sans body, Merriweather serif headings, as the web theme's h1/h2
%% scaled: Merriweather's x-height runs large, so 0.92 matches the old apparent size
\usepackage[rm,sfdefault,sflight,type1,scaled=0.92]{merriweather}
\setbeamerfont{title}{family=\rmfamily}
\setbeamerfont{subtitle}{family=\rmfamily}
\setbeamerfont{frametitle}{family=\rmfamily}
%% body weight 300, as the web theme has it; \seriesdefault is the load-bearing one,
%% since the package resets it to the serif family's series
\renewcommand{\mddefault}{light}
\renewcommand{\seriesdefault}{light}
%% block titles stay at medium, so a header still outweighs its own contents
\newcommand{\medseries}{\fontseries{m}\selectfont}
\setbeamerfont{block title}{series=\medseries}
\setbeamerfont{block title alerted}{series=\medseries}
\setbeamerfont{block title example}{series=\medseries}
%% a light default asks every family for a light series; these two have none, and
%% both must wait for their .fd to load -- see README.md for adding others
\AtBeginDocument{%
  \DeclareFontShape{OT1}{cmss}{light}{n}{<->ssub*cmss/m/n}{}%
  \@ifpackageloaded{wasysym}{%
    \input{uwasy.fd}%
    \DeclareFontShape{U}{wasy}{light}{n}{<->ssub*wasy/m/n}{}%
  }{}%
}
%% code: matches the body weight and is narrower than cmtt; varqu keeps quotes straight
\usepackage[varqu,varl]{inconsolata}
%% math: sans, to sit with the sans body; anyfontsize absorbs the 5.5/6.5pt substitutions
\usepackage{newtxsf}
\usepackage{anyfontsize}
%% workarounds, so that no document has to carry them -- see README.md
%% commands that cannot survive hyperref's PDF-string expansion.  The two
%% replacements below are \let into place, so that no parameter token ever
%% reaches \pdfstringdefDisableCommands, where it would not survive either.
%% a citation says nothing in a bookmark, and the note has to go with the keys:
%% only an expandable form is expanded away whole -- \NewDocumentCommand is
%% unexpandable, so hyperref would drop the name and leave [note]{keys} behind
\NewExpandableDocumentCommand{\ams@nocite}{o m}{}
%% the DOI is worth keeping in a bookmark, resolver and colour are not
\newcommand{\ams@nodoi}[1]{DOI:#1}
\ifdefined\pdfstringdefDisableCommands
  \pdfstringdefDisableCommands{%
    \let\speaker\@firstofone
    \let\sspeaker\@firstofone
    \let\ccite\ams@nocite
    \let\cccite\ams@nocite
    \let\uurl\@firstofone
    \let\uuurl\@firstofone
    \let\ddoi\ams@nodoi
    \let\dddoi\ams@nodoi
    \let\apicepar\@gobble
    \let\translate\@firstofone
    \let\\\space
  }
\fi
%% safety net: Computer Modern Sans has no small-caps shape, so a deck that
%% overrides the family back to it would hit the missing shape again
\DeclareFontShape{T1}{cmss}{m}{sc}{<->ssub*cmr/m/sc}{}
%
\mode
<all>
